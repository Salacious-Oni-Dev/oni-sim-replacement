TUNABLE(FizzUptakeKeepKg, fizz_uptake_keep_kg, float, 0x3B03126F, 0.0f, 1.0e6f, Fizz, OURS,
        "Gas a cell always keeps when a liquid dissolves from it (0.002 kg).")
TUNABLE(FizzUptakeMaxShare, fizz_uptake_max_share, float, 0x3F000000, 0.0f, 1.0f, Fizz, OURS,
        "Largest share of a gas cell dissolved in one step (0.5).")
TUNABLE(FizzFallbackSolventDensityKgM3, fizz_fallback_solvent_density_kg_m3, float, 0x447A0000,
        0.001f, 1.0e6f, Fizz, OURS,
        "Solvent density assumed for an element with no default mass (1000 kg/m^3).")

// ---- Liquid pressure break and over-full displacement --------------------------------------
TUNABLE(OverfullDisplaceRatio, overfull_displace_ratio, float, 0x3FC00000, 0.0f, 1000.0f, Liquid,
        KLEI, "A liquid over this many times its maxMass displaces the liquid above (1.5).")
TUNABLE(OverfullHeavierRatio, overfull_heavier_ratio, float, 0x3F8147AE, 0.0f, 100.0f, Liquid,
        KLEI, "How much heavier than the cell above an over-full liquid must be (1.01).")
TUNABLE(OverfullShare, overfull_share, float, 0x3EFEB9F3, 0.0f, 1.0f, Liquid, KLEI,
        "Share of an over-full cell moved up into the cleared cell (bits of 1/2.01).")
TUNABLE(PressureBreakBaseResistance, pressure_break_base_resistance, float, 0x3F800000, 0.0f,
        1.0e6f, Liquid, KLEI, "Resistance a pressure break starts from before any wall (1).")
TUNABLE(PressureBreakStrengthScale, pressure_break_strength_scale, float, 0x3E800000, 0.0f,
        1.0e6f, Liquid, KLEI, "Scale on each wall cell's strength term (0.25).")
TUNABLE(PressureBreakUnbuiltFloor, pressure_break_unbuilt_floor, float, 0x3DCCCCD0, 0.0f, 1.0e6f,
        Liquid, KLEI, "Resistance a natural (unbuilt) wall cell adds (bits 0x3dccccd0, ~0.1).")

// ---- The 0.125 pressure share, split by Klei function ---------------------------------------
// `GasPressureCap` is `UpdatePressure`'s. These two are the same value in two other Klei
// functions, split for the reason every shared value in this table is: one knob must not move
// three behaviours.
TUNABLE(GasPressureDisplacementShare, gas_pressure_displacement_share, float, 0x3E000000, 0.0f,
        1.0f, Gas, KLEI, "Share of a gas cell `DoGasPressureDisplacement` moves in (0.125).")
TUNABLE(LiquidPressureDisplacementShare, liquid_pressure_displacement_share, float, 0x3E000000,
        0.0f, 1.0f, Liquid, KLEI,
        "Share of a liquid's surplus `DoLiquidPressureDisplacement` moves (0.125).")

// ---- Further literals --------------------------------------------------------
// `ConductionMaxTemperature` is a CEILING like `MaxTemperature`, and a separate
// row because it is a separate Klei constant use.
TUNABLE(ConductionMinTemperature, conduction_min_temperature, float, 0x3F800000, 0.0f,
        10000.0f, Heat, KLEI,
        "Floor a conducting cell's temperature is clamped to after each pair (1 K).")
TUNABLE(ConductionMaxTemperature, conduction_max_temperature, float, 0x461C4000, 0.0f,
        10000.0f, Heat, KLEI,
        "Ceiling a conducting cell's temperature is clamped to after each pair (10000 K).")
TUNABLE(CellEnergyMinMassKg, cell_energy_min_mass_kg, float, 0x3A83126F, 0.0f, 1.0e6f,
        Building, KLEI, "A cell at or under this mass refuses ModifyCellEnergy/exhaust (0.001 kg).")
TUNABLE(CellEnergyMinTemperature, cell_energy_min_temperature, float, 0x3F800000, 0.0f,
        10000.0f, Building, KLEI,
        "Floor ModifyCellEnergy/exhaust clamps an out-of-range result to (1 K).")
TUNABLE(RadiationDecayStep, radiation_decay_step, float, 0x3F800000, 0.0f, 9000000.0f,
        Radiation, KLEI, "Rads a cell loses per tick when have/linger underflows to 0 (1).")
TUNABLE(GasEqualizeDamping, gas_equalize_damping, float, 0x3F000000, 0.0f, 1.0f, Mixture, OURS,
        "Share of the full equalising transfer MixPair/EqualizeSingleSpecies move (0.5).")
TUNABLE(LiquidEqualizeDamping, liquid_equalize_damping, float, 0x3F000000, 0.0f, 1.0f, Mixture,
        OURS, "Share of the full equalising transfer EqualizeLiquidVolume moves (0.5).")
// `DoLiquidPressureDisplacement`'s germ slice. Its own row, not
// `LiquidPressureDisplacementShare`: the same 0.125 in the same function, but a share of the
// source's START germ count where the mass share is a share of what is left after this
// substep's flow, so the two are not one quantity.
TUNABLE(LiquidDisplacementGermShare, liquid_displacement_germ_share, float, 0x3E000000, 0.0f,
        1.0f, Disease, KLEI,
        "Share of a source's germs a liquid pressure displacement carries with its slice (0.125).")
// `DoGasPressureDisplacement`'s germ slice. Its own row, not
// `GasPressureDisplacementShare`, for the reason `LiquidDisplacementGermShare` gives.
TUNABLE(GasDisplacementGermShare, gas_displacement_germ_share, float, 0x3E000000, 0.0f, 1.0f,
        Disease, KLEI,
        "Share of a source's germs a gas pressure displacement carries with its slice (0.125).")
// The mass a state change's ore share must exceed before it is spawned,
// which is also the gate on the germs that ride with it.
TUNABLE(TransitionOreMinKg, transition_ore_min_kg, float, 0x3A83126F, 0.0f, 1.0e6f, Phase, KLEI,
        "A state change's ore share is spawned only above this mass (0.001 kg).")
// A per-cell remainder for ModifyCellEnergy (simdll.cpp's ApplyCellEnergy, buildings.h's
// DeliverCellEnergy). Klei writes each payment as one float temperature step, so a payment small
// against the cell's heat capacity lands a whole number of float steps: 0.1 kJ into 1000 kg of
// water at 283 K lands 27% too much, 5 kJ lands 0.5% too little, and a stream of equal payments
// repeats the same error every time. On, the cell keeps what did not land and adds it to its
// next payment. Off is Klei's arithmetic, bit for bit.
TUNABLE(CellEnergyCarry, cell_energy_carry, int32_t, 0, 0, 1, Building, OURS,
        "1 = ModifyCellEnergy carries each cell's float-rounding remainder into its next payment (0).")
