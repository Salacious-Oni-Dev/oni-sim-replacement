// sim/tunables.def -- THE ONLY SOURCE of every number the sim runs on that managed code could
// not reach before. One row per tunable. Read by `tunables.h` (the `Tunables` struct, its ID
// enum and its default table). Nothing else defines these values: a kernel that wants one reads
// it from the live table (see tunables.h, "THE ONE RULE").
//
//   TUNABLE   (Name, field,        type, default_bits, min, max, Group, Origin, "meaning")
//   TUNABLE_AT(Name, array, index, type, default_bits, min, max, Group, Origin, "meaning")
//
// * `default_bits` is the value's BIT PATTERN for a float or a double, and the plain value for
//   an int32_t. Four Klei constants below exist only as bits (the RNG, stable-tick and noise
//   scales, the unbuilt-wall floor), because the nearest float to the quotient is not what Klei
//   stores and the difference decides coin flips; writing every row the same way means no row
//   can drift by being re-derived from a decimal.
// * `min` / `max` are inclusive sanity bounds, checked against the default at compile time
//   and (once the message exists) against every value sent. A CEILING row has max ==
//   its default: it may be lowered, never raised, because raising it would take the sim past a
//   limit the game relies on.
// * Origin: KLEI rows match the stock DLL and their default is a bit-exactness GATE; STN is
//   Stationeers' value; PHYS a physical constant; OURS a number this project chose.
// * ROWS ARE APPEND-ONLY. The ID enum is generated in row order, so a row inserted in the
//   middle renumbers every ID after it. Add new rows at the end of the file.
//
// Deliberately NOT here, each for its own reason:
//   * capacity limits that size ABI arrays;
//   * sentinels, which are identities of an algorithm rather than quantities:
//     `kHugeTemperature` (the min/max seed of a conduction tile scan) and
//     `World::kStableTicksReroll` (0x1f, the "roll a fresh countdown" value, which is also the
//     bit mask of the 5-bit countdown field it lives in);
//   * `FieldSource::cone_angle`'s 360, which every source overwrites from its own message;
//   * `TickRates::convection_every_n_ticks` / `radiant_every_n_ticks`, which nothing reads yet.
//   A knob with nothing behind it would pass every readback test and change nothing.

// ---- Heat / conduction ----------------------------------------------------------------------
TUNABLE(SubstepSeconds, substep_seconds, float, 0x3E4CCCCD, 0.01f, 1.0f, Heat, KLEI,
        "Seconds of simulated time per substep (0.2). Every rate in the sim is per substep.")
TUNABLE(MinConductionDelta, min_conduction_delta, float, 0x3F800000, 0.0f, 1000.0f, Heat, KLEI,
        "Cell pairs closer than this in temperature (K) exchange no heat (1.0).")
TUNABLE(ConductionTileShift, conduction_tile_shift, int32_t, 4, 1, 8, Heat, OURS,
        "log2 of the conduction quiet-tile edge in cells (4 = 16x16). Perf only.")
TUNABLE(BuildingTransferRate, building_transfer_rate, float, 0x3BA3D70A, 0.0f, 1.0f, Heat, KLEI,
        "Building-to-building heat transfer scale (0.005). Its cell form is derived.")
TUNABLE(MaxTemperature, max_temperature, float, 0x461C4000, 0.0f, 10000.0f, Heat, KLEI,
        "Ceiling for building, conduit and chunk temperatures (10000 K).")
TUNABLE(CellModMaxTemperature, cellmod_max_temperature, float, 0x461C4000, 0.0f, 10000.0f,
        Heat, KLEI, "Ceiling a ModifyCell or cell add clamps its temperature to (10000 K).")
TUNABLE(ConduitContactArea, conduit_contact_area, float, 0x42480000, 0.0f, 10000.0f, Heat, KLEI,
        "Pipe-contents to pipe-wall contact area (50).")
TUNABLE(ConduitTransferRate, conduit_transfer_rate, float, 0x3A83126F, 0.0f, 1.0f, Heat, KLEI,
        "Pipe-contents to pipe-wall transfer scale (0.001).")
TUNABLE(MinConduitHeatCapacity, min_conduit_heat_capacity, float, 0x38D1B717, 0.0f, 1.0f, Heat,
        KLEI, "A pipe side with no more heat capacity than this exchanges nothing (1e-4).")
TUNABLE(MinConduitEnergy, min_conduit_energy, float, 0x358637BD, 0.0f, 1.0f, Heat, KLEI,
        "Smallest pipe-to-cell energy transfer that is applied (1e-6).")
TUNABLE(ChunkTransferRate, chunk_transfer_rate, float, 0x3A83126F, 0.0f, 1.0f, Heat, KLEI,
        "Element-chunk (debris) to cell transfer scale (0.001).")

